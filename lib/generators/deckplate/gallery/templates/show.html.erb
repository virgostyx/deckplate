<%# Deckplate gallery (development only). Generated by `rails g deckplate:gallery`; edit or delete freely. %>
<% roles = %i[primary secondary tertiary accent muted info success warning danger emergency] %>
<%= render(Deckplate::Layout::FrameComponent.new) do |f|
  f.with_header { render(Deckplate::Shapes::BarComponent.new(color: :accent, caps: :end)) { |b| b.with_title { "Deckplate gallery" } } }
  f.with_main do
    safe_join([
      render(Deckplate::Layout::PageHeaderComponent.new(title: "Gallery", subtitle: "Development only")),
      render(Deckplate::ThemeSwitcherComponent.new),
      render(Deckplate::Layout::PanelComponent.new(title: "Colour roles", color: :primary)) do
        tag.div(class: "dp-gallery-row", style: "display: flex; flex-wrap: wrap; gap: .5rem") do
          safe_join(roles.map { |role| render(Deckplate::ButtonComponent.new(label: role.to_s.humanize, color: role)) })
        end
      end,
      render(Deckplate::Layout::PanelComponent.new(title: "Alerts", color: :info)) do
        safe_join(%i[info success warning danger].map { |kind| render(Deckplate::Feedback::AlertComponent.new(kind: kind, title: kind.to_s.humanize)) { "A #{kind} message." } })
      end,
      render(Deckplate::Layout::PanelComponent.new(title: "Readouts", color: :tertiary)) do
        safe_join([
          render(Deckplate::Data::ReadoutComponent.new(label: "Power", value: "72", unit: "%", color: :primary)),
          render(Deckplate::Data::ReadoutComponent.new(label: "Coolant", value: "18.4", unit: "°C", color: :info))
        ])
      end,
      render(Deckplate::Data::TableComponent.new(rows: [ [ "Power", 72.5 ], [ "Coolant", 18.4 ] ], caption: "Readings")) do |t|
        t.with_column(:name, header: "Sensor", row_header: true) { |row| row[0] }
        t.with_column(:value, header: "Value", align: :end, numeric: true) { |row| row[1] }
      end,
      render(Deckplate::Forms::TextInputComponent.new(name: "demo", label: "Text field", hint: "A hint under the label"))
    ])
  end
end %>
