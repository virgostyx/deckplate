<% label_content = capture do %>
  <%= @label %>
  <% if @required %><span class="dp-field__required" aria-hidden="true">*</span><span class="dp-sr-only"> (<%= t("deckplate.common.required") %>)</span><% end %>
<% end %>
<%= content_tag(fieldset? ? :fieldset : :div, **field_attributes) do %>
  <% if @label.present? %>
    <% if fieldset? %>
      <legend class="dp-field__label"><%= label_content %></legend>
    <% else %>
      <label class="dp-field__label" for="<%= @field_id %>"><%= label_content %></label>
    <% end %>
  <% end %>
  <% if @hint.present? %><p class="dp-field__hint" id="<%= hint_id %>"><%= @hint %></p><% end %>
  <div class="dp-field__control"><%= content %></div>
  <% if invalid? %>
    <%= tag.div(id: error_id, class: "dp-field__error", role: ("alert" if @alert)) do %>
      <%= helpers.dp_icon(:alert) %>
      <span class="dp-sr-only"><%= t("deckplate.forms.error_prefix") %>:</span>
      <ul class="dp-field__error-list"><% @errors.each do |message| %><li><%= message %></li><% end %></ul>
    <% end %>
  <% end %>
<% end %>
