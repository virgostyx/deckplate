<%= tag.div(**wrapper_attributes) do %>
  <div class="dp-slider__head">
    <%= tag.label(@label, for: input_id, class: "dp-slider__label") %>
    <% if @show_value %><%= tag.output(readout, for: input_id, class: "dp-slider__value", data: { dp_slider_target: "output" }) %><% end %>
  </div>
  <%= tag.input(**input_attributes) %>
<% end %>
