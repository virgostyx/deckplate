<div class="dp-root gx-page">
  <%= render(Deckplate::ModalComponent.new(title: "Confirm jump", id: "jump")) do |m|
    m.with_trigger { render Deckplate::ButtonComponent.new(label: "Open dialog", data: { action: "dp-modal#open" }) }
    m.with_actions do
      safe_join([
        render(Deckplate::ButtonComponent.new(label: "Cancel", color: :muted, data: { action: "dp-modal#close" })),
        render(Deckplate::ButtonComponent.new(label: "Engage", color: :primary, data: { action: "dp-modal#close" }))
      ])
    end
    "Engage the jump drive? This cannot be undone."
  end %>
  <p class="gx-filler">Page content behind the dialog.</p>
  <%= render Deckplate::ButtonComponent.new(label: "Another focusable", color: :secondary) %>
</div>
