<div class="dp-root gx-page"><div style="max-inline-size: 28rem; display: grid; gap: 1.1rem">
  <%= render Deckplate::Data::ProgressComponent.new(label: "Empty", value: 0, show_value: true, color: :info) %>
  <%= render Deckplate::Data::ProgressComponent.new(label: "Almost", value: 99.5, show_value: true, color: :success) %>
  <%= render Deckplate::Data::ProgressComponent.new(label: "Full", value: 100, show_value: true, color: :warning) %>
  <%= render Deckplate::Data::ProgressComponent.new(label: "Segmented", value: 60, segments: 10, show_value: true, color: :accent) %>
  <%= render Deckplate::Data::ProgressComponent.new(label: "Few segments", value: 50, segments: 4, color: :tertiary) %>
  <%= render Deckplate::Data::ProgressComponent.new(label: "Waiting for the server", value: nil, color: :secondary) %>
</div></div>
