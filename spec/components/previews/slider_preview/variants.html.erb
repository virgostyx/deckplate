<div class="dp-root gx-page">
  <div style="max-inline-size: 24rem; display: grid; gap: 1rem">
    <%= render Deckplate::SliderComponent.new(name: "warp", label: "Warp factor", min: 1, max: 9, step: 0.5, value: 4.5, color: :secondary) %>
    <%= render Deckplate::SliderComponent.new(name: "temp", label: "Temperature", min: -20, max: 40, value: 18, unit: " °C", color: :info) %>
    <%= render Deckplate::SliderComponent.new(name: "hidden", label: "No readout", value: 30, show_value: false, color: :accent) %>
    <%= render Deckplate::SliderComponent.new(name: "off", label: "Disabled", value: 60, disabled: true) %>
    <%= render Deckplate::SliderComponent.new(name: "min", label: "At minimum", value: 0) %>
    <%= render Deckplate::SliderComponent.new(name: "max", label: "At maximum", value: 100, color: :danger) %>
  </div>
</div>
