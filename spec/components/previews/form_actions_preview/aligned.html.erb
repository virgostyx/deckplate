<div class="dp-root gx-page">
  <%= render(Deckplate::Forms::FormActionsComponent.new(align: :end)) do %>
    <%= render Deckplate::ButtonComponent.new(label: "Cancel", href: "/", color: :muted) %>
    <%= render Deckplate::ButtonComponent.new(label: "Save", type: "submit", color: :success) %>
  <% end %>
  <p class="gx-label">narrow container (14rem)</p>
  <div style="max-inline-size: 14rem">
    <%= render(Deckplate::Forms::FormActionsComponent.new) do %>
      <%= render Deckplate::ButtonComponent.new(label: "Save changes", type: "submit") %>
      <%= render Deckplate::ButtonComponent.new(label: "Discard", href: "/", color: :danger) %>
      <%= render Deckplate::ButtonComponent.new(label: "Preview", href: "/", color: :info) %>
    <% end %>
  </div>
</div>
