<div class="dp-root gx-page">
  <div style="display: grid; gap: .5rem; justify-items: start">
    <%= render Deckplate::ToggleComponent.new(name: "a", label: "Off") %>
    <%= render Deckplate::ToggleComponent.new(name: "b", label: "On", checked: true) %>
    <%= render Deckplate::ToggleComponent.new(name: "c", label: "Disabled off", disabled: true) %>
    <%= render Deckplate::ToggleComponent.new(name: "d", label: "Disabled on", checked: true, disabled: true) %>
    <%= render Deckplate::ToggleComponent.new(name: "e", label: "Warning colour", checked: true, color: :warning) %>
    <%= render Deckplate::ToggleComponent.new(name: "f", label: "Info colour", checked: true, color: :info) %>
    <%= render Deckplate::ToggleComponent.new(name: "g", label: "Submits 0 when off", unchecked_value: "0") %>
    <div style="max-inline-size: 14rem">
      <%= render Deckplate::ToggleComponent.new(name: "h", label: "A rather long label that has to wrap inside a narrow column", checked: true) %>
    </div>
  </div>
</div>
