<div class="dp-root gx-page">
  <p class="gx-label">header actions + footer</p>
  <%= render(Deckplate::Layout::PanelComponent.new(title: "Cargo", color: :accent, corners: :left)) do |p|
    p.with_header_actions { tag.span("[edit]") }
    p.with_footer { "Updated 14:02" }
    "Bay 3: 128 units"
  end %>
  <p class="gx-label">empty body</p>
  <%= render(Deckplate::Layout::PanelComponent.new(title: "Empty", color: :warning, corners: :both)) { "" } %>
  <p class="gx-label">long title and long content in a narrow container (16rem)</p>
  <div style="inline-size: 16rem">
    <%= render(Deckplate::Layout::PanelComponent.new(title: "An extraordinarily long panel title", color: :secondary, corners: :left)) do
      "Averyveryverylongunbreakablewordthatmustnotoverflowthepanelboundaries and then some ordinary text that wraps."
    end %>
  </div>
</div>
