<%# A frame composed only of Deckplate pieces. locals: variant, fixed, animate %>
<%= render(Deckplate::Layout::FrameComponent.new(variant: variant, fixed: fixed, animate: animate)) do |f|
  unless variant == :minimal
    f.with_top_start_corner { render Deckplate::Shapes::ElbowComponent.new(corner: :top_start, color: :accent) }
    f.with_bottom_start_corner { render Deckplate::Shapes::ElbowComponent.new(corner: :bottom_start, color: :tertiary) }
  end
  f.with_header do
    tag.div(class: "gx-header") do
      render(Deckplate::Shapes::BarComponent.new(color: :accent, caps: :end)) { |b| b.with_title { "Aurora · Engineering" } }
    end
  end
  f.with_sidebar do
    tag.div(class: "gx-side") do
      safe_join([
        render(Deckplate::Shapes::BlockComponent.new(color: :primary, number: "01")) { "Overview" },
        render(Deckplate::Shapes::BlockComponent.new(color: :info, number: "02")) { "Sensors" },
        render(Deckplate::Shapes::BlockComponent.new(color: :secondary, number: "03")) { "Power" },
        render(Deckplate::Shapes::BlockComponent.new(color: :tertiary, number: "04")) { "Crew" }
      ])
    end
  end
  f.with_aside { render(Deckplate::Layout::PanelComponent.new(title: "Alerts", color: :warning)) { "No active alerts." } } if variant == :double
  f.with_main do
    safe_join([
      render(Deckplate::Layout::PageHeaderComponent.new(title: "Overview", subtitle: "Deck 7")),
      tag.div(class: "gx-dash") do
        safe_join([
          render(Deckplate::Layout::PanelComponent.new(title: "Power", color: :primary, corners: :left)) { tag.span("72%", class: "gx-big") },
          render(Deckplate::Layout::PanelComponent.new(title: "Coolant", color: :info, corners: :left)) { tag.span("18.4 °C", class: "gx-big") }
        ])
      end,
      tag.p("Filler paragraph.", class: "gx-filler"),
      *Array.new(variant == :minimal || fixed ? 24 : 0) { |i| tag.p("Line #{i + 1} of scrolling content.", class: "gx-filler") }
    ])
  end
  f.with_footer { render(Deckplate::Shapes::BarComponent.new(color: :tertiary, caps: :end)) { |b| b.with_title { "Condition normal" } } }
end %>
