<!DOCTYPE html>
<html lang="en" <%= tag.attributes(dp_theme_attrs) %>>
  <head>
    <title><%= content_for(:title) || "Deckplate dummy" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="turbo-refresh-method" content="morph">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= dp_font_tags %>
    <%= stylesheet_link_tag "deckplate" %>
    <%= stylesheet_link_tag "gallery" %>
    <%= javascript_importmap_tags %>
  </head>
  <%= tag.body class: "dp-root", **dp_sound_attrs do %>
    <main class="gx-page">
      <%# The flash becomes toasts in the live region; a page may supply its own container (content_for :toast_container) %>
      <% if content_for?(:toast_container) %>
        <%= yield :toast_container %>
      <% else %>
        <%= dp_toast_container(max: 3) { notice ? render(Deckplate::Feedback::ToastComponent.new(kind: :success).with_content(notice)) : nil } %>
      <% end %>
      <%= yield %>
    </main>
    <footer class="gx-page"><%= render Deckplate::ThemeSwitcherComponent.new %></footer>
  <% end %>
</html>
