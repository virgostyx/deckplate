<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-dp-theme="<%= preview_theme %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Deckplate preview</title>
    <%= dp_font_tags %>
    <%# ?sheets=core,forms links only those sheets (ADR 0012); the default is the all-in-one deckplate.css %>
    <% sheets = params[:sheets].to_s.split(",").select { |name| %w[core controls forms data feedback].include?(name) } %>
    <% if sheets.empty? %>
      <%= stylesheet_link_tag "deckplate" %>
    <% else %>
      <% sheets.each do |name| %><%= stylesheet_link_tag "deckplate-#{name}" %><% end %>
    <% end %>
    <%= stylesheet_link_tag "gallery" %>
    <%= csp_meta_tag %>
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
    <%= javascript_importmap_tags %>
  </head>
  <body class="dp-root">
    <%= yield %>
  </body>
</html>
